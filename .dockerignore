# Build output — never send to daemon
dist/
node_modules/

# Editor / OS artifacts
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Git
.git/
.gitignore

# CI / tooling config (not needed inside the image)
.github/
.husky/
.vscode/
.idea/

# Docker files themselves (no recursive nesting)
Dockerfile
.dockerignore

# Environment files — use --build-arg or Dokploy env vars instead
.env
.env.*
!.env.example

# README / docs
README.md
*.md
