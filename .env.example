# ============================================
# ComES Frontend - Environment Configuration
# ============================================

# API Configuration - Change this for production
# This is the ONLY place to change the backend URL
VITE_API_URL=http://localhost:5001/api/v1

# API Request Timeout (in milliseconds)
VITE_API_TIMEOUT=10000

# Cloudinary photo uploads use the authenticated backend API.
# Configure CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, and CLOUDINARY_API_SECRET
# in ../comes-web-backend/.env and the backend hosting environment.
# No Cloudinary variables are needed here. VITE_* values are public;
# never add the Cloudinary API secret to the frontend environment.

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NEWSLETTER=true
VITE_ENABLE_STUDENT_PORTAL=true
